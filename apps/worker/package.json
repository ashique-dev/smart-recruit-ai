{
  "version": "0.1.0",
  "private": true,
  "name": "@smart-recruit/worker",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "smoke": "node dist/smoke.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@smart-recruit/config": "workspace:*",
    "@smart-recruit/shared": "workspace:*",
    "@smart-recruit/api": "workspace:*",
    "bullmq": "5.81.5"
  },
  "devDependencies": {
    "tsc-watch": "7.2.1"
  }
}
