generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Infrastructure and Phase 2 identity/notification foundation only.
model InfrastructureState {
  id          Int      @id
  version     Int
  installedAt DateTime @default(now()) @db.Timestamptz
}

model WorkerHeartbeat {
  id        String   @id
  updatedAt DateTime @db.Timestamptz
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum CompanyRole {
  COMPANY_ADMIN
  RECRUITER
  VIEWER
}

enum OperationStatus {
  PENDING
  RUNNING
  RETRY_WAIT
  RESULT_READY
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  SENDING
  RETRY_WAIT
  SMTP_ACCEPTED
  FAILED
  CANCELLED
  EXPIRED
}

model User {
  id              String                     @id @default(uuid()) @db.Uuid
  normalizedEmail String                     @unique
  passwordHash    String
  displayName     String
  status          AccountStatus              @default(ACTIVE)
  verifiedAt      DateTime?                  @db.Timestamptz
  createdAt       DateTime                   @default(now()) @db.Timestamptz
  updatedAt       DateTime                   @updatedAt @db.Timestamptz
  memberships     CompanyMembership[]
  sessions        RefreshSession[]
  resets          PasswordResetToken[]
  securityEvents  AuthSecurityEvent[]
  deliveries      AuthNotificationDelivery[]
}

model Company {
 approvalCommands RubricApprovalCommand[]
  id                     String                 @id @default(uuid()) @db.Uuid
  name                   String
  status                 CompanyStatus          @default(ACTIVE)
  revision               Int                    @default(1)
  retentionDays          Int                    @default(180)
  retentionPolicyVersion Int                    @default(1)
  createdAt              DateTime               @default(now()) @db.Timestamptz
  updatedAt              DateTime               @updatedAt @db.Timestamptz
  memberships            CompanyMembership[]
  invitations            CompanyInvitation[]
  operations             ProcessingOperation[]
  outbox                 OutboxEvent[]
  deliveries             NotificationDelivery[]
  audit                  AuditLog[]
  jobs Job[]
  configs JobEvaluationConfig[]
  criteria RubricCriterion[]
  aiRequests AiRequest[]
  artifacts AIArtifact[]
  usage UsageRecord[]
}

model CompanyMembership {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @db.Uuid
  userId      String              @db.Uuid
  role        CompanyRole
  status      MembershipStatus    @default(ACTIVE)
  revision    Int                 @default(1)
  createdAt   DateTime            @default(now()) @db.Timestamptz
  updatedAt   DateTime            @updatedAt @db.Timestamptz
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitations CompanyInvitation[]
  audit       AuditLog[]
  jobs Job[]
  approvals JobEvaluationConfig[]

  @@unique([companyId, id])
  @@unique([companyId, userId])
  @@index([userId])
}

model RefreshSession {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  tokenHash   String           @unique
  familyId    String           @db.Uuid
  expiresAt   DateTime         @db.Timestamptz
  revokedAt   DateTime?        @db.Timestamptz
  rotatedAt   DateTime?        @db.Timestamptz
  successorId String?          @unique @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  successor   RefreshSession?  @relation("rotation", fields: [userId, familyId, successorId], references: [userId, familyId, id], onDelete: Restrict)
  predecessor RefreshSession[] @relation("rotation")

  @@unique([userId, familyId, id])
  @@index([familyId])
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id         String                     @id @default(uuid()) @db.Uuid
  userId     String                     @db.Uuid
  tokenHash  String                     @unique
  expiresAt  DateTime                   @db.Timestamptz
  consumedAt DateTime?                  @db.Timestamptz
  revokedAt  DateTime?                  @db.Timestamptz
  createdAt  DateTime                   @default(now()) @db.Timestamptz
  user       User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveries AuthNotificationDelivery[]

  @@unique([userId, id])
  @@index([userId, expiresAt])
}

model AuthSecurityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  kind        String
  networkHash String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  user        User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model CompanyInvitation {
  id                 String                 @id @default(uuid()) @db.Uuid
  companyId          String                 @db.Uuid
  normalizedEmail    String
  role               CompanyRole
  issuerMembershipId String                 @db.Uuid
  tokenHash          String                 @unique
  generation         Int                    @default(1)
  expiresAt          DateTime               @db.Timestamptz
  consumedAt         DateTime?              @db.Timestamptz
  revokedAt          DateTime?              @db.Timestamptz
  createdAt          DateTime               @default(now()) @db.Timestamptz
  updatedAt          DateTime               @updatedAt @db.Timestamptz
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  issuer             CompanyMembership      @relation(fields: [companyId, issuerMembershipId], references: [companyId, id], onDelete: Restrict)
  deliveries         NotificationDelivery[]

  @@unique([companyId, id])
  @@index([companyId, issuerMembershipId])
  @@index([companyId, expiresAt])
}

model ProcessingOperation {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @db.Uuid
  kind            String
  idempotencyKey  String
  status          OperationStatus       @default(PENDING)
  attemptCount    Int                   @default(0)
  leaseGeneration Int                   @default(0)
  leaseExpiresAt  DateTime?             @db.Timestamptz
  availableAt     DateTime              @default(now()) @db.Timestamptz
  deadlineAt      DateTime              @db.Timestamptz
  failureCode     String?
  createdAt       DateTime              @default(now()) @db.Timestamptz
  updatedAt       DateTime              @updatedAt @db.Timestamptz
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  outbox          OutboxEvent[]
  delivery        NotificationDelivery?
  aiRequest AiRequest?
  artifact AIArtifact?
  usage UsageRecord[]

  @@unique([companyId, id])
  @@unique([companyId, kind, idempotencyKey])
}

model OutboxEvent {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @db.Uuid
  operationId     String              @db.Uuid
  topic           String
  schemaVersion   Int                 @default(1)
  availableAt     DateTime            @default(now()) @db.Timestamptz
  publishedAt     DateTime?           @db.Timestamptz
  leaseExpiresAt  DateTime?           @db.Timestamptz
  leaseGeneration Int                 @default(0)
  createdAt       DateTime            @default(now()) @db.Timestamptz
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  operation       ProcessingOperation @relation(fields: [companyId, operationId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, operationId])
}

model AuditLog {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @db.Uuid
  actorMembershipId String            @db.Uuid
  actorType         String            @default("MEMBER")
  action            String
  entityType        String
  entityId          String            @db.Uuid
  requestId         String            @db.Uuid
  summary           Json
  createdAt         DateTime          @default(now()) @db.Timestamptz
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor             CompanyMembership @relation(fields: [companyId, actorMembershipId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, actorMembershipId])
  @@index([companyId, createdAt, id])
}

model NotificationDelivery {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @db.Uuid
  operationId  String @unique @db.Uuid
  invitationId String @db.Uuid

  template         String
  templateVersion  Int            @default(1)
  generation       Int            @default(1)
  status           DeliveryStatus @default(PENDING)
  ciphertext       String?
  keyVersion       String?
  payloadExpiresAt DateTime       @db.Timestamptz
  attemptCount     Int            @default(0)
  leaseGeneration  Int            @default(0)
  leaseExpiresAt   DateTime?      @db.Timestamptz
  availableAt      DateTime       @default(now()) @db.Timestamptz
  smtpAcceptedAt   DateTime?      @db.Timestamptz
  failureCode      String?
  createdAt        DateTime       @default(now()) @db.Timestamptz
  updatedAt        DateTime       @updatedAt @db.Timestamptz

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  operation  ProcessingOperation @relation(fields: [companyId, operationId], references: [companyId, id], onDelete: Restrict)
  invitation CompanyInvitation   @relation(fields: [companyId, invitationId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([companyId, operationId])
  @@index([companyId, invitationId])
}

model AuthNotificationDelivery {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @db.Uuid
  resetTokenId String @db.Uuid
  operationKey String @unique

  template         String
  templateVersion  Int            @default(1)
  generation       Int            @default(1)
  status           DeliveryStatus @default(PENDING)
  ciphertext       String?
  keyVersion       String?
  payloadExpiresAt DateTime       @db.Timestamptz
  attemptCount     Int            @default(0)
  leaseGeneration  Int            @default(0)
  leaseExpiresAt   DateTime?      @db.Timestamptz
  availableAt      DateTime       @default(now()) @db.Timestamptz
  smtpAcceptedAt   DateTime?      @db.Timestamptz
  failureCode      String?
  createdAt        DateTime       @default(now()) @db.Timestamptz
  updatedAt        DateTime       @updatedAt @db.Timestamptz

  user   User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  reset  PasswordResetToken @relation(fields: [userId, resetTokenId], references: [userId, id], onDelete: Restrict)
  outbox AuthOutboxEvent[]

  @@index([userId, resetTokenId])
}

model AuthOutboxEvent {
  id              String                   @id @default(uuid()) @db.Uuid
  deliveryId      String                   @db.Uuid
  topic           String
  schemaVersion   Int                      @default(1)
  availableAt     DateTime                 @default(now()) @db.Timestamptz
  publishedAt     DateTime?                @db.Timestamptz
  leaseExpiresAt  DateTime?                @db.Timestamptz
  leaseGeneration Int                      @default(0)
  createdAt       DateTime                 @default(now()) @db.Timestamptz
  delivery        AuthNotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@index([deliveryId])
}


enum JobStatus {
 DRAFT
 ACTIVE
 PAUSED
 CLOSED
 ARCHIVED
}
model Job {
 approvalCommands RubricApprovalCommand[]
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 creatorMembershipId String @db.Uuid
 title String
 description String
 department String
 employmentType String
 workArrangement String
 location String
 requirements Json
 status JobStatus @default(DRAFT)
 revision Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz
 updatedAt DateTime @updatedAt @db.Timestamptz
 company Company @relation(fields:[companyId], references:[id], onDelete:Restrict)
 creator CompanyMembership @relation(fields:[companyId,creatorMembershipId], references:[companyId,id], onDelete:Restrict)
 configs JobEvaluationConfig[]
 requests AiRequest[]
 artifacts AIArtifact[]
 @@unique([companyId,id])
 @@index([companyId,status,createdAt,id])
 @@index([companyId,creatorMembershipId])
}
model JobEvaluationConfig {
 approvalCommands RubricApprovalCommand[]
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 jobId String @db.Uuid
 version Int
 revision Int @default(1)
 status String @default("DRAFT")
 sourceDescription String
 sourceHash String
 requirements Json
 scaleVersion String @default("rating-0-4.v1")
 scoringPolicyVersion String @default("scoring-policy-v1")
 artifactId String? @db.Uuid
 approverMembershipId String? @db.Uuid
 approvedAt DateTime? @db.Timestamptz
 createdAt DateTime @default(now()) @db.Timestamptz
 company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
 job Job @relation(fields:[companyId,jobId],references:[companyId,id],onDelete:Restrict)
 approver CompanyMembership? @relation(fields:[companyId,approverMembershipId],references:[companyId,id],onDelete:Restrict)
 artifact AIArtifact? @relation(fields:[companyId,jobId,artifactId],references:[companyId,jobId,id],onDelete:Restrict)
 criteria RubricCriterion[]
 @@unique([companyId,id])
 @@unique([companyId,jobId,id])
 @@unique([companyId,jobId,version])
 @@index([companyId,approverMembershipId])
 @@index([companyId,artifactId])
}
model RubricCriterion {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 configId String @db.Uuid
 key String
 label String
 description String
 weight Int
 anchors Json
 evidenceRequirements String
 requirementKeys String[]
 position Int
 company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
 config JobEvaluationConfig @relation(fields:[companyId,configId],references:[companyId,id],onDelete:Restrict)
 @@unique([companyId,id])
 @@unique([companyId,configId,key])
 @@unique([companyId,configId,position])
}
model AiRequest {
 artifact AIArtifact?
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 jobId String @db.Uuid
 operationId String @unique @db.Uuid
 jobRevision Int
 task String
 mode String
 model String
 promptVersion String
 schemaVersion String
 policyVersion String
 policySnapshot Json
 input Json
 inputHash String
 company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
 job Job @relation(fields:[companyId,jobId],references:[companyId,id],onDelete:Restrict)
 operation ProcessingOperation @relation(fields:[companyId,operationId],references:[companyId,id],onDelete:Restrict)
 @@unique([companyId,id])
 @@index([companyId,jobId])
 @@unique([companyId,jobId,operationId])
 @@unique([companyId,operationId])
}
model AIArtifact {
 request AiRequest @relation(fields:[companyId,jobId,operationId],references:[companyId,jobId,operationId],onDelete:Restrict)
 jobId String @db.Uuid
 job Job @relation(fields:[companyId,jobId],references:[companyId,id],onDelete:Restrict)
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 operationId String @unique @db.Uuid
 task String
 model String
 provider String
 promptVersion String
 schemaVersion String
 inputHash String
 outputHash String
 output Json
 createdAt DateTime @default(now()) @db.Timestamptz
 company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
 operation ProcessingOperation @relation(fields:[companyId,operationId],references:[companyId,id],onDelete:Restrict)
 configs JobEvaluationConfig[]
 @@unique([companyId,jobId,operationId])
 @@unique([companyId,jobId,id])
 @@unique([companyId,id])
 @@unique([companyId,operationId])
}
model UsageRecord {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 operationId String @db.Uuid
 attempt Int
 mode String
 task String
 model String
 returnedModel String?
 provider String?
 promptVersion String
 schemaVersion String
 inputTokens Int?
 outputTokens Int?
 cacheReadTokens Int?
 cacheWriteTokens Int?
 providerGenerationId String?
 usageMetadataStatus String @default("UNKNOWN")
 settledAt DateTime? @db.Timestamptz
 cost Decimal? @db.Decimal(18,8)
 currency String @default("USD")
 costStatus String @default("UNKNOWN")
 outcome String @default("UNKNOWN")
 latencyMs Int?
 reservedTokens Int
 reservedCost Decimal @default(0) @db.Decimal(18,8)
 createdAt DateTime @default(now()) @db.Timestamptz
 company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
 operation ProcessingOperation @relation(fields:[companyId,operationId],references:[companyId,id],onDelete:Restrict)
 @@unique([companyId,id])
 @@unique([companyId,operationId,attempt])
 @@index([companyId,createdAt,id])
}

model RubricApprovalCommand {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 jobId String @db.Uuid
 configId String @db.Uuid
 idempotencyKey String @db.Uuid
 requestHash String
 result Json
 createdAt DateTime @default(now()) @db.Timestamptz
 company Company @relation(fields:[companyId],references:[id],onDelete:Restrict)
 job Job @relation(fields:[companyId,jobId],references:[companyId,id],onDelete:Restrict)
 config JobEvaluationConfig @relation(fields:[companyId,jobId,configId],references:[companyId,jobId,id],onDelete:Restrict)
 @@unique([companyId,id])
 @@unique([companyId,jobId,configId,idempotencyKey])
}
