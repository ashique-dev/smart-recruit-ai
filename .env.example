# Local development only. Run: node scripts/setup-env.mjs
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
EDGE_PORT=8080
POSTGRES_DB=smart_recruit
POSTGRES_USER=smart_recruit_owner
POSTGRES_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=smart_recruit_root
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=smart_recruit_app
S3_SECRET_KEY=
S3_BUCKET=smart-recruit-private
S3_REGION=us-east-1
# Explicit selection only; Phase 1 performs no AI inference.
AI_PROVIDER=mock

# Independent 32-byte hex keys; never reuse infrastructure credentials.
AUTH_SIGNING_KEY=
AUTH_KEY_ID=v1
CSRF_KEY=
NOTIFICATION_ENCRYPTION_KEY=
NOTIFICATION_KEY_VERSION=v1
SMTP_FROM=noreply@example.test

# Phase 3: leave mock enabled until explicit live-test approval.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_JOB_ANALYSIS=
AI_MODEL_RUBRIC_DRAFT=
# Verified route JSON; see docs/phase-3-verification.md. No candidate defaults.
AI_ROUTE_MANIFEST=
AI_TIMEOUT_MS=90000
AI_COMPANY_CONCURRENCY=2
AI_DAILY_TOKEN_BUDGET=1000000
AI_DAILY_CALL_LIMIT=100
AI_DAILY_COST_BUDGET_USD=10
